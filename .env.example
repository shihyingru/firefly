# 螢火 Firefly — 環境變數範本 / environment template
#
# 用法 / Usage:
#   cp .env.example .env
# 然後把下面每個 CHANGE_ME 換成獨立的隨機值。/ Then replace every CHANGE_ME with an independent random value.
#
# 產生密鑰 / Generate a secret (32 bytes, one per variable):
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# 產生 LINE_PUSH_ENC_KEY(Fernet 專用格式)/ Fernet key for LINE_PUSH_ENC_KEY:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# 本檔案是範本,不含任何真實密鑰,必須進版控。
# .env 含真實密鑰,絕對不可進版控(.gitignore 已擋)。
# This file is a template. It holds no real secrets and must stay tracked.
# .env holds real secrets and must never be committed (.gitignore blocks it).

# --- 連線 / Connections -------------------------------------------------
# docker compose 用服務名 db / redis;本機開發改成 127.0.0.1。
# Compose uses the service names db / redis; use 127.0.0.1 for local dev.
DATABASE_URL=postgresql+asyncpg://firefly:firefly@db:5432/firefly
REDIS_URL=redis://redis:6379/0

# --- 核心密鑰(上線前必改)/ Core secrets (must change before launch) ----
# 裝置代號雜湊椒鹽;更換會使所有既有裝置代號失效。/ device-token pepper; changing it invalidates all tokens
DEVICE_TOKEN_PEPPER=CHANGE_ME
# LINE userId 的 HMAC 金鑰(D-011);原始 userId 永不落地。/ HMAC key for LINE userId (D-011)
LINE_ID_HMAC_KEY=CHANGE_ME
# 內部服務端點的 bearer token。/ bearer token for internal service endpoints
SERVICE_TOKEN=CHANGE_ME

# --- 部署 / Deployment --------------------------------------------------
# 對外網址,卡片頁連結與隱私權政策網址都用它(維護者決定 B7 後填入)。
# Public base URL; used for card links and the privacy policy (fill in after decision B7).
PUBLIC_BASE_URL=http://localhost:8000
ENVIRONMENT=dev

# --- LINE Bot(文件 7.1)-------------------------------------------------
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# D-014 引導期推播的 Fernet 金鑰;只加密存在 Redis,有 TTL。
# Fernet key for the D-014 onboarding push; encrypted, Redis-only, with a TTL.
LINE_PUSH_ENC_KEY=

# --- Threads Bot(文件 7.2;需 Meta App Review,D-003)-------------------
THREADS_APP_ID=
THREADS_APP_SECRET=
# App Review 通過後填入長效 user token。/ long-lived user token, after App Review
THREADS_USER_TOKEN=
# webhook 驗證用,自訂隨機字串。/ your own random string for webhook verification
THREADS_WEBHOOK_VERIFY_TOKEN=CHANGE_ME

# --- Wayback 存證(選用;開啟前先實測額度)/ optional, verify SPN quota first
WAYBACK_ACCESS_KEY=
WAYBACK_SECRET_KEY=

# --- LLM(選用;僅 config/firefly.yaml 的 card.llm_enabled=true 時需要)--
# 預設關閉(D-001、B2)。/ off by default (D-001, B2)
ANTHROPIC_API_KEY=
